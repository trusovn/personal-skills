{
  "version": 2,
  "run_id": "example-run",
  "repository": "/absolute/path/to/repository",
  "task_ids": [
    "T1"
  ],
  "flow": {
    "version": 2,
    "profile": "reviewed",
    "steps": [
      {
        "kind": "ready",
        "role": "controller",
        "mode": "off"
      },
      {
        "kind": "preflight",
        "role": "preflight",
        "mode": "light"
      },
      {
        "kind": "implement",
        "role": "implementer",
        "mode": "standard"
      },
      {
        "kind": "verify",
        "role": "verifier",
        "mode": "targeted"
      },
      {
        "kind": "semantic_review",
        "role": "review_collector",
        "mode": "standard"
      },
      {
        "kind": "acceptance",
        "role": "acceptance_reviewer",
        "mode": "standard"
      },
      {
        "kind": "accept",
        "role": "controller",
        "mode": "off"
      },
      {
        "kind": "completed",
        "role": "controller",
        "mode": "off"
      }
    ],
    "actor_levels": {
      "light": {
        "model": "gpt-6.1-sol",
        "reasoning": "low"
      },
      "standard": {
        "model": "gpt-6.1-sol",
        "reasoning": "medium"
      },
      "strong": {
        "model": "gpt-6.1-sol",
        "reasoning": "high"
      }
    },
    "implementation_session_reuse_threshold": 0.5,
    "correction": {
      "enabled": true,
      "limit": 3,
      "includes_environment_repair": true
    },
    "routes": {
      "blocked": "stop",
      "failed": "stop",
      "needs_input": "escalate",
      "unexpected_changes": "stop",
      "inconclusive": "escalate",
      "corrections_exhausted": "escalate",
      "permission_expansion": "stop",
      "plan_or_architecture_question": "escalate"
    }
  },
  "verification": {
    "targeted_checks": [
      "python3 -m unittest tests.test_example"
    ],
    "repository_gate": null,
    "authorized_gap": null
  },
  "permissions": {
    "sandbox": "workspace-write",
    "approval_policy": "never",
    "network": false,
    "dependency_install": false,
    "writable_roots": [
      "/absolute/path/to/repository"
    ],
    "danger_full_access_authorized": false
  },
  "commit_policy": {
    "mode": "off"
  },
  "stop_policy": {
    "on_blocked": "stop",
    "on_failed": "stop",
    "on_needs_input": "escalate",
    "on_unexpected_changes": "stop"
  },
  "execution_authorization": {
    "transport": "sbx",
    "yolo": true,
    "intervention": "active_chat"
  }
}
