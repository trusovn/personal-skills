{
  "version": 2,
  "profile": "fast-local",
  "steps": [
    {
      "kind": "ready",
      "role": "controller",
      "mode": "off"
    },
    {
      "kind": "preflight",
      "role": "preflight",
      "mode": "light"
    },
    {
      "kind": "implement",
      "role": "implementer",
      "mode": "standard"
    },
    {
      "kind": "verify",
      "role": "verifier",
      "mode": "targeted"
    },
    {
      "kind": "semantic_review",
      "role": "review_collector",
      "mode": "standard"
    },
    {
      "kind": "acceptance",
      "role": "acceptance_reviewer",
      "mode": "standard"
    },
    {
      "kind": "accept",
      "role": "controller",
      "mode": "off"
    },
    {
      "kind": "completed",
      "role": "controller",
      "mode": "off"
    }
  ],
  "actor_levels": {
    "light": {
      "model": "gpt-6.1-sol",
      "reasoning": "low"
    },
    "standard": {
      "model": "gpt-6.1-sol",
      "reasoning": "medium"
    },
    "strong": {
      "model": "gpt-6.1-sol",
      "reasoning": "high"
    }
  },
  "implementation_session_reuse_threshold": 0.5,
  "correction": {
    "enabled": true,
    "limit": 3,
    "includes_environment_repair": true
  },
  "routes": {
    "blocked": "stop",
    "failed": "stop",
    "needs_input": "escalate",
    "unexpected_changes": "stop",
    "inconclusive": "escalate",
    "corrections_exhausted": "escalate",
    "permission_expansion": "stop",
    "plan_or_architecture_question": "escalate"
  }
}
