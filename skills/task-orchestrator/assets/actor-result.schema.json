{
  "type": "object",
  "properties": {
    "assignment": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        },
        "operation_id": {
          "type": "string"
        },
        "operation_key": {
          "type": "string"
        },
        "stage": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "inputs_sha256": {
          "type": "string"
        },
        "policy_sha256": {
          "type": "string"
        },
        "flow_sha256": {
          "type": "string"
        },
        "flow_revision": {
          "type": "integer"
        },
        "candidate_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "correction_count": {
          "type": "integer"
        },
        "can_repair": {
          "type": "boolean"
        },
        "can_change_files": {
          "type": "boolean"
        },
        "session_policy": {
          "type": [
            "string",
            "null"
          ]
        },
        "actor": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string"
            },
            "reasoning": {
              "type": "string"
            }
          },
          "required": [
            "model",
            "reasoning"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "run_id",
        "task_id",
        "operation_id",
        "operation_key",
        "stage",
        "role",
        "reason",
        "inputs_sha256",
        "policy_sha256",
        "flow_sha256",
        "flow_revision",
        "candidate_sha256",
        "correction_count",
        "can_repair",
        "can_change_files",
        "session_policy",
        "actor"
      ],
      "additionalProperties": false
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "blocked",
        "failed",
        "needs_input"
      ]
    },
    "summary": {
      "type": "string"
    },
    "readiness": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ready",
            "blocked"
          ]
        },
        "requirements_complete": {
          "type": "boolean"
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "passed",
                  "blocked"
                ]
              },
              "evidence": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "status",
              "evidence"
            ],
            "additionalProperties": false
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "passed",
                  "blocked"
                ]
              },
              "evidence": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "status",
              "evidence"
            ],
            "additionalProperties": false
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "passed",
                  "blocked"
                ]
              },
              "evidence": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "status",
              "evidence"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "status",
        "requirements_complete",
        "tools",
        "dependencies",
        "skills"
      ],
      "additionalProperties": false
    },
    "collection": {
      "type": "object",
      "properties": {
        "coverage": {
          "type": "object",
          "properties": {
            "requirements": {
              "type": "object",
              "properties": {
                "status": {
                  "enum": [
                    "passed",
                    "blocked",
                    "not_run"
                  ]
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "status",
                "evidence"
              ],
              "additionalProperties": false
            },
            "behavior": {
              "type": "object",
              "properties": {
                "status": {
                  "enum": [
                    "passed",
                    "blocked",
                    "not_run"
                  ]
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "status",
                "evidence"
              ],
              "additionalProperties": false
            },
            "code_quality": {
              "type": "object",
              "properties": {
                "status": {
                  "enum": [
                    "passed",
                    "blocked",
                    "not_run"
                  ]
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "status",
                "evidence"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "requirements",
            "behavior",
            "code_quality"
          ],
          "additionalProperties": false
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "requirement": {
                "type": "string",
                "minLength": 1
              },
              "context": {
                "type": "string",
                "minLength": 1
              },
              "exposure": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "id",
              "evidence",
              "requirement",
              "context",
              "exposure"
            ],
            "additionalProperties": false
          }
        },
        "rerun_path": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "coverage",
        "gaps",
        "findings",
        "rerun_path"
      ],
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "properties": {
        "action": {
          "enum": [
            "accept",
            "correct",
            "missing_evidence",
            "blocker"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "dispositions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "blocking",
                  "known_issue",
                  "observation",
                  "resolved",
                  "missing_evidence",
                  "blocker"
                ]
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "trigger": {
                "type": "string",
                "minLength": 1
              },
              "consequence": {
                "type": "string",
                "minLength": 1
              },
              "boundary": {
                "type": "string",
                "minLength": 1
              },
              "impact": {
                "type": "string",
                "minLength": 1
              },
              "likelihood": {
                "type": "string",
                "minLength": 1
              },
              "mitigation": {
                "type": "string",
                "minLength": 1
              },
              "compatible_consumers": {
                "type": "string",
                "minLength": 1
              },
              "follow_up": {
                "type": "string",
                "minLength": 1
              },
              "reassess_when": {
                "type": "string",
                "minLength": 1
              },
              "requirement_violation": {
                "type": "boolean"
              },
              "material_risk": {
                "type": "boolean"
              },
              "correction_authorized": {
                "type": "boolean"
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "id",
              "kind",
              "rationale",
              "trigger",
              "consequence",
              "boundary",
              "impact",
              "likelihood",
              "mitigation",
              "compatible_consumers",
              "follow_up",
              "reassess_when",
              "requirement_violation",
              "material_risk",
              "correction_authorized",
              "evidence"
            ],
            "additionalProperties": false
          }
        },
        "unfinished": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "owner": {
                "enum": [
                  "verify",
                  "semantic_review",
                  "intervene"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "owner",
              "reason",
              "evidence"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "action",
        "rationale",
        "evidence",
        "dispositions",
        "unfinished"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "assignment",
    "session_id",
    "status",
    "summary",
    "readiness"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "if": {
        "properties": {
          "assignment": {
            "properties": {
              "stage": {
                "const": "semantic_review"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "collection"
        ],
        "properties": {
          "readiness": {
            "type": "null"
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "collection"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "assignment": {
            "properties": {
              "stage": {
                "const": "acceptance"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "decision"
        ],
        "properties": {
          "readiness": {
            "type": "null"
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "decision"
          ]
        }
      }
    }
  ]
}
