{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "execution-evidence.schema.v2.json",
  "title": "Execution evidence v2 four-record model",
  "properties": {
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["logical_name", "content_ref"],
        "properties": {
          "logical_name": {"type": "string", "minLength": 1, "pattern": "^(?!\\s*$)(?!.*[\\\\/]).+$"},
          "content_ref": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "required": ["schema_version", "record_type", "artifacts"],
      "properties": {
        "schema_version": {"const": 2},
        "record_type": {"const": "ProjectSnapshot"},
        "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
        "collector_fingerprint": {
          "anyOf": [{"type": "null"}, {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}]
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["schema_version", "record_type", "task_id", "task_brief_ref", "artifact_refs"],
      "properties": {
        "schema_version": {"const": 2},
        "record_type": {"const": "TaskRevision"},
        "task_id": {"type": "string", "minLength": 1, "pattern": "^(?!\\s*$)(?!.*[\\/]).+$"},
        "task_brief_ref": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "artifact_refs": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
        "planning_project_snapshot_ref": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}]},
        "planning": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "task_type": {},
            "intended_scope": {},
            "behavioral_scope": {},
            "transformation_type": {},
            "implementation_precedent": {},
            "state_or_compatibility_constraints": {},
            "verification_work": {},
            "discovery_uncertainty": {},
            "expected_calls": {},
            "expected_duration": {},
            "confidence": {},
            "planner_recommended_profile": {},
            "reasoning_effort": {},
            "split_decision": {},
            "provenance": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "knowledge_status": {
                  "type": "string",
                  "enum": ["observed", "mechanically_extracted", "planner_declared", "planner_estimated", "externally_supplied", "inferred", "unknown", "not_applicable"]
                },
                "source": {"type": "string", "minLength": 1, "pattern": "^(?!\\s*$)(?!.*[\\/]).+$"}
              }
            }
          }
        },
        "decomposition": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "parent_task_id": {"type": "string", "minLength": 1, "pattern": "^(?!\\s*$)(?!.*[\\/]).+$"},
            "child_task_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1, "pattern": "^(?!\\s*$)(?!.*[\\/]).+$"}
            },
            "source_plan_ref": {"type": "string", "minLength": 1, "pattern": "^(?!\\s*$)(?!.*[\\/]).+$"}
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["attempt_id", "schema_version", "record_type", "task", "pre_run", "execution", "post_run", "evidence"],
      "properties": {
        "attempt_id": {"type": "string", "minLength": 1, "pattern": "^(?!\\s*$)(?!.*[\\/]).+$"},
        "schema_version": {"const": 2},
        "record_type": {"const": "ExecutionAttempt"},
        "task": {
          "type": "object",
          "oneOf": [
            {
              "additionalProperties": false,
              "required": ["direct_input_ref"],
              "properties": {"direct_input_ref": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
            },
            {
              "additionalProperties": false,
              "required": ["task_revision_ref"],
              "properties": {"task_revision_ref": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
            }
          ]
        },
        "execution_project_snapshot_ref": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}]},
        "pre_run": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository_state", "workflow_identity", "actual_runtime_identity"],
          "properties": {
            "repository_state": {"type": "object"},
            "workflow_identity": {"type": "object"},
            "actual_runtime_identity": {"type": "object"},
            "intended_execution_profile": {"type": "object"},
            "assignment_provenance": {"type": "object"},
            "conditions": {"type": "object"}
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["started_at", "termination_state"],
          "properties": {
            "started_at": {"type": "string", "minLength": 1},
            "finished_at": {"type": "string", "minLength": 1},
            "terminated_at": {"type": "string", "minLength": 1},
            "termination_state": {"type": "string", "minLength": 1},
            "checks": {"type": "array", "items": {"type": "object"}},
            "telemetry": {"type": "object"}
          }
        },
        "post_run": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository_state"],
          "properties": {"repository_state": {"type": "object"}}
        },
        "related_attempts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["relation", "attempt_id"],
            "properties": {
              "relation": {"type": "string", "enum": ["retry_of", "correction_of", "continuation_of", "profile_replay_of", "calibration_of"]},
              "attempt_id": {"type": "string", "minLength": 1, "pattern": "^(?!\\s*$)(?!.*[\\/]).+$"}
            }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "collector_fingerprint"],
          "properties": {
            "schema_version": {"const": 2},
            "collector_fingerprint": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}]}
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["association_id", "attempt_id", "schema_version", "record_type", "type", "producer", "outcome_status", "collected_at"],
      "properties": {
        "association_id": {"type": "string", "minLength": 1, "pattern": "^(?!\\s*$)(?!.*[\\/]).+$"},
        "attempt_id": {"type": "string", "minLength": 1, "pattern": "^(?!\\s*$)(?!.*[\\/]).+$"},
        "schema_version": {"const": 2},
        "record_type": {"const": "Association"},
        "type": {"type": "string", "minLength": 1, "pattern": "^(?!\\s*$)(?!.*[\\/]).+$"},
        "producer": {"type": "object"},
        "durable_artifact_ref": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}]},
        "outcome_status": {"type": "object"},
        "provenance": {"type": "object"},
        "collected_at": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_name", "content_ref"],
      "properties": {
        "logical_name": {"type": "string", "minLength": 1, "pattern": "^(?!\\s*$)(?!.*[\\/]).+$"},
        "content_ref": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "execution_checks": {
      "type": "array",
      "items": {"type": "object"}
    },
    "collector_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "collector_fingerprint"],
      "properties": {
        "schema_version": {"const": 2},
        "collector_fingerprint": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}]}
      }
    }
  }
}
