{
  "version": 1,
  "run_id": "example-run",
  "repository": "/absolute/path/to/repository",
  "task_ids": [
    "T1"
  ],
  "flow": {
    "actor_levels": {
      "light": {
        "model": "gpt-5.6-sol",
        "reasoning": "low"
      },
      "standard": {
        "model": "gpt-5.6-sol",
        "reasoning": "medium"
      },
      "strong": {
        "model": "gpt-5.6-sol",
        "reasoning": "high"
      }
    },
    "correction": {
      "enabled": true,
      "limit": 2
    },
    "implementation_session_reuse_threshold": 0.5,
    "profile": "reviewed",
    "routes": {
      "blocked": "stop",
      "corrections_exhausted": "escalate",
      "failed": "stop",
      "inconclusive": "escalate",
      "needs_input": "escalate",
      "permission_expansion": "stop",
      "plan_or_architecture_question": "escalate",
      "unexpected_changes": "stop"
    },
    "steps": [
      {
        "kind": "preflight",
        "mode": "light",
        "role": "preflight"
      },
      {
        "kind": "implement",
        "mode": "standard",
        "role": "implementer"
      },
      {
        "kind": "verify",
        "mode": "targeted",
        "role": "verifier"
      },
      {
        "kind": "semantic_review",
        "mode": "standard",
        "role": "semantic_reviewer"
      },
      {
        "kind": "accept",
        "mode": "off",
        "role": "controller"
      }
    ],
    "version": 1
  },
  "verification": {
    "targeted_checks": [
      "python3 -m unittest tests.test_example"
    ],
    "repository_gate": null,
    "authorized_gap": null
  },
  "permissions": {
    "sandbox": "workspace-write",
    "approval_policy": "never",
    "network": false,
    "dependency_install": false,
    "writable_roots": [
      "/absolute/path/to/repository"
    ],
    "danger_full_access_authorized": false
  },
  "commit_policy": {
    "mode": "off"
  },
  "stop_policy": {
    "on_blocked": "stop",
    "on_failed": "stop",
    "on_needs_input": "escalate",
    "on_unexpected_changes": "stop"
  }
}
