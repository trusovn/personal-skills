{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-skills.local/contract-index.schema.json",
  "title": "Implemented Contract Registry Index",
  "type": "object",
  "required": ["schema_version", "generated", "subsystems", "plan_refs"],
  "properties": {
    "schema_version": {"const": 1},
    "generated": {"const": true},
    "subsystems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "owner_paths", "contract"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "owner_paths": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "contract": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "plan_refs": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "string", "minLength": 1},
        "uniqueItems": true
      }
    }
  },
  "additionalProperties": false
}
