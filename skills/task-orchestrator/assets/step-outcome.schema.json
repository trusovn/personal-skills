{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:task-orchestrator:step-outcome:v1",
  "title": "Task Orchestrator Step Outcome",
  "type": "object",
  "required": [
    "version",
    "subject",
    "result",
    "evidence_status",
    "artifact_refs",
    "payload"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "subject": {
      "$ref": "handoff.schema.json#/$defs/subject"
    },
    "result": {
      "enum": [
        "ready",
        "blocked",
        "needs_input",
        "complete",
        "failed",
        "mechanically_eligible",
        "findings",
        "collected",
        "ACCEPT",
        "CHANGES_REQUESTED",
        "INCONCLUSIVE"
      ]
    },
    "evidence_status": {
      "const": "reported"
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "$ref": "handoff.schema.json#/$defs/reference"
      }
    },
    "payload": {
      "type": "object",
      "required": [
        "version",
        "reference"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "reference": {
          "oneOf": [
            {
              "$ref": "handoff.schema.json#/$defs/reference"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "subject": {
          "properties": {
            "step": {
              "const": "preflight"
            }
          }
        },
        "result": {
          "enum": [
            "ready",
            "blocked",
            "needs_input"
          ]
        }
      }
    },
    {
      "properties": {
        "subject": {
          "properties": {
            "step": {
              "const": "implement"
            }
          }
        },
        "result": {
          "enum": [
            "complete",
            "needs_input",
            "failed"
          ]
        }
      }
    },
    {
      "properties": {
        "subject": {
          "properties": {
            "step": {
              "const": "correction"
            }
          }
        },
        "result": {
          "enum": [
            "complete",
            "needs_input",
            "failed"
          ]
        }
      }
    },
    {
      "properties": {
        "subject": {
          "properties": {
            "step": {
              "const": "verify"
            }
          }
        },
        "result": {
          "enum": [
            "mechanically_eligible",
            "findings"
          ]
        }
      }
    },
    {
      "properties": {
        "subject": {
          "properties": {
            "step": {
              "const": "semantic_review"
            }
          }
        },
        "result": {
          "enum": [
            "collected",
            "findings",
            "INCONCLUSIVE"
          ]
        }
      }
    },
    {
      "properties": {
        "subject": {
          "properties": {
            "step": {
              "const": "acceptance"
            }
          }
        },
        "result": {
          "enum": [
            "ACCEPT",
            "CHANGES_REQUESTED",
            "INCONCLUSIVE"
          ]
        }
      }
    }
  ]
}
